{
  "entities": {
    "Order": {
      "path": "shops/trufas_bella/orders/{orderId}",
      "schema": {
        "userId": "string",
        "clientName": "string",
        "brigadeiro": "number",
        "pacoca": "number",
        "ninho": "number",
        "ninhoNutella": "number",
        "maracuja": "number",
        "outro": "number",
        "unitPriceSimple": "number",
        "unitPriceSpecial": "number",
        "paymentMethod": "string",
        "isPaid": "boolean",
        "notes": "string",
        "dateMillis": "number",
        "createdAt": "string"
      }
    },
    "Flavor": {
      "path": "shops/trufas_bella/flavors/{flavorId}",
      "schema": {
        "userId": "string",
        "name": "string",
        "price": "number",
        "isSpecial": "boolean"
      }
    }
  }
}
